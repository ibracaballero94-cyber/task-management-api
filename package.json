{
  "name": "task-management-api",
  "version": "1.0.0",
  "description": "API REST para gestionar tareas (Express + TypeScript + SQLite)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate-cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
  "task-management",
  "rest-api",
  "express",
  "typescript",
  "sqlite"
],
  "author": "Ibrahim Caballero <ibracaballero94@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
  "node": ">=22.12.0"
},
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  }
}
